#compdef howto

_howto() {
  local -a commands model_commands server_commands shell_commands config_commands config_keys
  commands=(
    'setup:download the model and configure HowTo'
    'doctor:check setup, model, and provider readiness'
    'model:install or inspect the model'
    'server:inspect or stop the embedded engine'
    'shell:manage shell integration'
    'config:read or change configuration'
    'help:show help'
    'version:show version'
  )
  model_commands=(
    'status:inspect the local model'
    'list:compare model profiles'
    'install:download, verify, and select a model profile'
  )
  server_commands=(
    'status:inspect the resident embedded engine'
    'stop:stop the resident embedded engine'
  )
  shell_commands=(
    'init:print a shell adapter'
    'enable:enable context-aware Tab insertion'
    'disable:disable context-aware Tab insertion'
    'status:inspect the Tab integration'
  )
  config_commands=(
    'list:list configuration'
    'path:print the configuration path'
    'get:print one setting'
    'set:change one setting'
    'unset:restore one setting to its default'
  )
  config_keys=(
    'model_profile:selected catalog profile (read-only selection)'
    'model_path:local GGUF model path'
    'llama_server_path:deprecated local-runtime path'
    'server_url:completion provider URL'
    'threads:inference worker threads'
    'context_size:model context size'
    'max_tokens:maximum generated tokens'
    'startup_timeout_seconds:embedded-engine startup deadline'
    'accelerator:embedded-engine accelerator (auto or cpu)'
    'show_tab_hint:show the post-query Tab reminder'
    'failed_command_advisor:enable beta local failure suggestions'
    'shell_path:execution shell path'
    'model_id:completion model name'
  )

  if (( CURRENT > 2 )); then
    case $words[2] in
      setup)
        _arguments \
          '(-y --yes)'{-y,--yes}'[accept default-Yes setup prompts]' \
          '--model[select a qualified model profile]:profile:(compact balanced accurate)' \
          '--no-shell[disable and omit Tab integration]' \
          '--shell[configure a specific shell]:shell:(zsh bash fish)' \
          '--help[show help]'
        return
        ;;
      doctor)
        _values 'option' '--json[emit JSON]' '--deep[verify the model digest]'
        return
        ;;
      model)
        if (( CURRENT == 3 )); then
          _values 'model command or option' \
            'status[inspect the local model]' \
            'list[compare model profiles]' \
            'install[download, verify, and select a model profile]' \
            '--json[emit JSON]' \
            '--deep[verify the model digest]' \
            '--help[show help]'
        elif [[ $words[3] == status ]]; then
          _values 'option' '--json[emit JSON]' '--deep[verify the model digest]'
        elif [[ $words[3] == list ]]; then
          _values 'option' '--json[emit JSON]'
        elif [[ $words[3] == install ]]; then
          _arguments \
            '(-y --yes)'{-y,--yes}'[install without prompting]' \
            '1:profile:(compact balanced accurate)'
        fi
        return
        ;;
      server)
        if (( CURRENT == 3 )); then
          _values 'server command or option' \
            'status[inspect the resident embedded engine]' \
            'stop[stop the resident embedded engine]' \
            '--json[emit JSON]' \
            '--help[show help]'
        else
          _values 'option' '--json[emit JSON]'
        fi
        return
        ;;
      shell)
        if (( CURRENT == 3 )); then
          _describe 'shell command' shell_commands
        else
          case $words[3] in
            init)
              _values 'shell' zsh bash fish
              ;;
            enable|disable)
              _arguments '--shell[shell to configure]:shell:(zsh bash fish)'
              ;;
            status)
              _values 'option' '--json[emit JSON]'
              ;;
          esac
        fi
        return
        ;;
      config)
        if (( CURRENT == 3 )); then
          _values 'configuration command or option' \
            'list[list configuration]' \
            'path[print the configuration path]' \
            'get[print one setting]' \
            'set[change one setting]' \
            'unset[restore one setting to its default]' \
            '--json[emit JSON]' \
            '--help[show help]'
        elif [[ $words[3] == list ]]; then
          _values 'option' '--json[emit JSON]'
        elif (( CURRENT == 4 )) && [[ $words[3] == get || $words[3] == set || $words[3] == unset ]]; then
          _describe 'configuration key' config_keys
        elif (( CURRENT == 5 )) \
          && [[ $words[3] == set \
            && ( $words[4] == show_tab_hint || $words[4] == failed_command_advisor ) ]]; then
          _values 'boolean' true false
        elif (( CURRENT == 5 )) && [[ $words[3] == set && $words[4] == accelerator ]]; then
          _values 'accelerator' auto cpu
        fi
        return
        ;;
    esac
  fi

  _arguments -C \
    '(-h --help)'{-h,--help}'[show help]' \
    '(-V --version)'{-V,--version}'[show version]' \
    '(-x -e --execute)'{-x,-e,--execute}'[execute after confirmation]' \
    '(-c --copy)'{-c,--copy}'[copy generated command]' \
    '(-q --quiet)'{-q,--quiet}'[print only a no-known-risk command]' \
    '(-n --count)'{-n,--count}'[generate alternatives]:count (1-8):' \
    '--json[emit JSON]' \
    '--timing[show generation timing]' \
    '1:command or request:->command' \
    '*:request words:'

  case $state in
    command)
      _describe 'command' commands
      ;;
  esac
}

_howto "$@"

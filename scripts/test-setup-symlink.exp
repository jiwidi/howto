#!/usr/bin/env expect -f

# Exercise the security-sensitive startup-symlink consent flow through a real
# pseudo-terminal. A configured dummy provider keeps setup offline and avoids a
# model/runtime dependency.

set timeout 10
log_user 0

set project_root [file normalize [file join [file dirname [info script]] ..]]
if {[info exists env(HOWTO_TEST_BINARY)] && $env(HOWTO_TEST_BINARY) ne ""} {
    set howto [file normalize $env(HOWTO_TEST_BINARY)]
} else {
    set howto [file join $project_root target debug howto]
}
if {![file executable $howto] || ![file isfile $howto]} {
    puts stderr "FAIL: HowTo test binary is missing or not executable: $howto"
    puts stderr "Build it first with: cargo build --locked --bin howto"
    exit 1
}

set temp_parent /tmp
if {[info exists env(TMPDIR)] && $env(TMPDIR) ne ""} {
    set temp_parent $env(TMPDIR)
}
set temp_root [file join $temp_parent "howto-setup-symlink.[pid].[clock clicks]"]
if {[catch {file mkdir $temp_root} mkdir_error]} {
    puts stderr "FAIL: could not create temporary directory: $mkdir_error"
    exit 1
}
set temp_root [file normalize $temp_root]

proc write_text {path contents} {
    set channel [open $path w]
    puts -nonewline $channel $contents
    close $channel
}

proc read_text {path} {
    set channel [open $path r]
    set contents [read $channel]
    close $channel
    return $contents
}

proc cleanup {} {
    global spawn_id temp_root
    if {[info exists spawn_id]} {
        catch {send -- "\003"}
        catch {close}
        catch {wait}
        unset -nocomplain spawn_id
    }
    catch {file delete -force -- $temp_root}
}

proc fail {message} {
    cleanup
    puts stderr "FAIL: $message"
    exit 1
}

proc assert_true {condition message} {
    if {![uplevel 1 [list expr $condition]]} {
        fail $message
    }
}

proc assert_equal {actual expected message} {
    if {$actual ne $expected} {
        fail "$message\nexpected: <$expected>\nactual:   <$actual>"
    }
}

proc normalized_terminal_text {value} {
    return [string map [list "\r\n" "\n" "\r" "\n"] $value]
}

proc create_fixture {name} {
    global temp_root

    set root [file join $temp_root $name]
    set home [file join $root home]
    set state [file join $root state]
    set dotfiles [file join $home dotfiles]
    file mkdir $dotfiles
    file mkdir $state

    set link [file join $home .zshrc]
    set target [file join $dotfiles zshrc]
    set original "export HOWTO_USER_SETTING=kept\n"
    write_text $target $original
    file link -symbolic $link [file join dotfiles zshrc]
    write_text [file join $state config.json] \
        "{\"schema\":1,\"server_url\":\"https://provider.example\"}\n"

    return [list $home $state $link [file normalize $target] $original]
}

proc expected_block {state} {
    set adapter [file join $state shell howto.zsh]
    return "# >>> HowTo shell integration >>>\nif \[ -r '$adapter' \]; then\n  . '$adapter'\nfi\n# <<< HowTo shell integration <<<\n"
}

proc expect_symlink_review {link target block} {
    global expect_out

    expect {
        -exact "HowTo found a symbolic link in the shell startup path:" {}
        timeout { fail "setup did not explain that the startup file is a symbolic link" }
        eof { fail "setup exited before displaying the symbolic-link review" }
    }
    expect {
        -exact "Startup path: $link" {}
        timeout { fail "setup did not display the startup link path" }
        eof { fail "setup exited before displaying the startup link path" }
    }
    expect {
        -exact "Resolved target: $target" {}
        timeout { fail "setup did not display the canonical target path" }
        eof { fail "setup exited before displaying the canonical target path" }
    }
    expect {
        -re {(?s)----- BEGIN HOWTO MANAGED BLOCK -----\r?\n(.*)----- END HOWTO MANAGED BLOCK -----} {
            set displayed [normalized_terminal_text $expect_out(1,string)]
            assert_equal $displayed $block \
                "setup did not display the exact block it would write"
        }
        timeout { fail "setup did not display the proposed managed block" }
        eof { fail "setup exited before displaying the proposed managed block" }
    }
    expect {
        -exact "Allow HowTo to follow this symbolic link and update the resolved target? \[y/N\] " {}
        timeout { fail "setup did not present the default-No symlink consent prompt" }
        eof { fail "setup exited before requesting symlink consent" }
    }
}

proc wait_for_success {name expected_message} {
    global expect_out spawn_id

    expect {
        -exact $expected_message {}
        timeout { fail "$name did not report the expected setup outcome" }
        eof { fail "$name exited before reporting the expected setup outcome" }
    }
    expect {
        -exact "HowTo setup is complete." {}
        timeout { fail "$name did not complete setup" }
        eof { fail "$name exited before confirming setup completion" }
    }
    expect {
        eof {}
        timeout { fail "$name did not exit after setup completed" }
    }
    set wait_result [wait]
    unset -nocomplain spawn_id
    if {[lindex $wait_result 3] != 0} {
        fail "$name exited with status [lindex $wait_result 3]"
    }
}

proc verify_declined {name answer} {
    global env howto spawn_id

    lassign [create_fixture $name] home state link target original
    set link_value [file readlink $link]
    set block [expected_block $state]

    set env(HOME) $home
    set env(ZDOTDIR) $home
    set env(SHELL) /bin/zsh
    set env(HOWTO_HOME) $state
    unset -nocomplain env(HOWTO_SHELL_SESSION)

    spawn -noecho $howto setup --yes
    expect_symlink_review $link $target $block
    send -- $answer
    wait_for_success $name "Tab integration was skipped at your request."

    assert_equal [file type $link] link "$name replaced the startup symlink"
    assert_equal [file readlink $link] $link_value "$name changed the startup symlink target"
    assert_equal [read_text $target] $original "$name modified the resolved target after refusal"
    assert_true {![file exists [file join $state shell howto.zsh]]} \
        "$name installed an adapter after refusal"
    assert_true {[llength [glob -nocomplain -- "$target.howto-backup-*"]] == 0} \
        "$name created a startup backup despite making no change"

    set receipt [read_text [file join $state setup.json]]
    assert_true {[string first {"shell": null} $receipt] >= 0} \
        "$name did not complete setup without shell integration"
    assert_true {[string first $target $receipt] < 0} \
        "$name recorded an unapproved startup target"
}

proc verify_approved {} {
    global env howto spawn_id

    lassign [create_fixture approved] home state link target original
    set link_value [file readlink $link]
    set block [expected_block $state]

    set env(HOME) $home
    set env(ZDOTDIR) $home
    set env(SHELL) /bin/zsh
    set env(HOWTO_HOME) $state
    unset -nocomplain env(HOWTO_SHELL_SESSION)

    spawn -noecho $howto setup --yes
    expect_symlink_review $link $target $block
    send -- "y\r"
    wait_for_success approved "Enabled context-aware Tab integration for zsh."

    assert_equal [file type $link] link "approval replaced the startup symlink"
    assert_equal [file readlink $link] $link_value "approval changed the startup symlink target"
    assert_equal [read_text $target] "$original\n$block" \
        "approval did not modify only the canonical target with the reviewed block"
    assert_true {[file isfile [file join $state shell howto.zsh]]} \
        "approval did not install the zsh adapter"
    assert_true {[llength [glob -nocomplain -- "$target.howto-backup-*"]] == 1} \
        "approval did not create exactly one backup beside the canonical target"
    assert_true {[llength [glob -nocomplain -- "$link.howto-backup-*"]] == 0} \
        "approval created a backup beside the symlink instead of its target"

    set receipt [read_text [file join $state setup.json]]
    assert_true {[string first {"shell": "zsh"} $receipt] >= 0} \
        "approval did not record zsh integration"
    assert_true {[string first $target $receipt] >= 0} \
        "approval did not record the canonical startup target"
    assert_true {[string first $link $receipt] < 0} \
        "approval recorded the symlink path instead of its canonical target"
}

# Blank input exercises the prompt's default No; an explicit `n` must be
# equivalent. Both still complete core setup with the optional integration off.
verify_declined default-no "\r"
verify_declined explicit-no "n\r"
verify_approved

puts "PASS: interactive setup startup-symlink consent"
cleanup
exit 0
